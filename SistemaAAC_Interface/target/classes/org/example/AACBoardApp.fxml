<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AACBoardAppController">
   <top>
      <VBox spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
         <children>
            <Label text="🧩 Gerador de Pranchas CAA (Comunicação Aumentativa e Alternativa)" 
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <TextField fx:id="campoTema" promptText="Digite o tema ou pedido (ex: hora do almoço, brincar no parque)..." 
                             HBox.hgrow="ALWAYS" prefHeight="38.0" style="-fx-font-size: 14px;" />
                  <Button fx:id="botaoGerar" text="Gerar Prancha" onAction="#aoClicarGerar" 
                          prefHeight="38.0" prefWidth="140.0" 
                          style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                  <ProgressIndicator fx:id="indicadorProgresso" visible="false" prefHeight="30.0" prefWidth="30.0" />
               </children>
            </HBox>
            <Label fx:id="rotuloStatus" text="Digite um tema acima e clique em 'Gerar Prancha'." 
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: #ecf0f1;">
         <content>
            <FlowPane fx:id="containerCards" hgap="15.0" vgap="15.0" style="-fx-padding: 20; -fx-alignment: center;">
               <!-- Os cards de pictogramas gerados serão inseridos aqui dinamicamente -->
            </FlowPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
